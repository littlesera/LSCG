{
  "name": "ls-club-games",
  "description": "Little Sera's Club Games",
  "version": "0.9.6",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "typed-scss-modules src --exportType=default --nameFormat=none && vite build && npm run build:api-types",
    "build:api-types": "tsc -p tsconfig.api.json",
    "pack:types": "npm run build:api-types && node scripts/pack-types.mjs",
    "watch": "vite build --watch --mode development",
    "watch-prod": "vite build --watch",
    "serve": "serve dist -p 10001 --cors",
    "serve:examples": "serve examples -p 10002 --cors",
    "dev": "typed-scss-modules src --exportType=default --nameFormat=none && concurrently \"npm run watch\" \"npm run serve\" \"npm run serve:examples\"",
    "prod-watch": "typed-scss-modules src --exportType=default --nameFormat=none && concurrently \"npm run watch-prod\" \"npm run serve\"",
    "lint": "eslint src",
    "playground": "node scripts/bc-playground.mjs",
    "ui:shots": "node scripts/ui-shots.mjs",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:bc": "vitest run --project bc",
    "test:all": "vitest run",
    "report:speech": "node scripts/speech-report.mjs",
    "coverage": "vitest run --project unit --coverage",
    "fetch-bc": "node scripts/fetch-bc.mjs"
  },
  "keywords": [],
  "author": "Little Sera",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littlesera/sera.git"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/socket.io-client": "^3.0.0",
    "bondage-club-mod-sdk": "^1.2.0",
    "compromise": "^14.15.0",
    "lz-string": "^1.5.0",
    "obscenity": "^0.4.6",
    "sentiment": "^5.0.2",
    "socket.io-client": "^4.8.3",
    "typed-scss-modules": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.3.0",
    "@types/semver": "^7.7.1",
    "@types/sentiment": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "bc-stubs": "^132.0.0-Beta.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.1",
    "eslint-plugin-css": "^0.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lodash-es": "^4.17.23",
    "sass": "^1.97.3",
    "semver": "^7.7.4",
    "serve": "^14.2.5",
    "simple-git": "^3.32.1",
    "stylelint": "17.3.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "tslib": "^2.8.1",
    "tsx-dom": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
